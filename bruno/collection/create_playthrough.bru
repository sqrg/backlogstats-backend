meta {
  name: Create Playthrough
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/collection/{{collectionId}}/playthroughs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "NOT_STARTED",
    "started_at": null,
    "completed_at": null,
    "completion_time": null,
    "notes": null
  }
}
