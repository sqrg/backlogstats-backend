meta {
  name: Discord OAuth2
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/discord
  body: json
  auth: none
}

body:json {
  {
    "code": "",
    "redirect_uri": ""
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.access_token);
  }
}
